---
import '../styles/site.css';

interface Props {
  titulo: string;
  descricao: string;
  tipo?: 'website' | 'article';
  jsonld?: Record<string, unknown> | Record<string, unknown>[];
  ativo?: 'home' | 'blog' | 'privacidade';
  og?: string; // caminho da imagem de compartilhamento
}
const { titulo, descricao, tipo = 'website', jsonld, ativo, og: ogPath = '/og-padrao.png' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = new URL(ogPath, Astro.site).href;
// build fora de produção (preview/branch do Netlify) não entra no Google
const naoIndexar = !!process.env.CONTEXT && process.env.CONTEXT !== 'production';
// na home os links do menu rolam a página; fora dela, levam pra home
const h = ativo === 'home' ? '' : '/';
const ano = new Date().getFullYear();
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{titulo}</title>
  <meta name="description" content={descricao} />
  <link rel="canonical" href={canonical} />
  {naoIndexar && <meta name="robots" content="noindex, nofollow" />}
  <meta property="og:type" content={tipo} />
  <meta property="og:site_name" content="VIA Growth" />
  <meta property="og:locale" content="pt_BR" />
  <meta property="og:title" content={titulo} />
  <meta property="og:description" content={descricao} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={og} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#FBFBFD" />
  <link rel="icon" href="/logo-via.png" />
  <link rel="alternate" type="application/rss+xml" title="Blog da VIA Growth" href="/rss.xml" />

  <!-- ═══ CAMADA DE DADOS ═══════════════════════════════════════════
       Nasce antes de tudo, então nenhum evento se perde por ordem de
       carregamento. Eventos: page_data (home), cta_click (todas),
       form_start, generate_lead e form_error (formulário da home).
       PARA LIGAR O GTM: colar o snippet oficial logo abaixo deste bloco
       e o <noscript> no início do <body>. Não apagar este bloco.
  ════════════════════════════════════════════════════════════════ -->
  <script is:inline>window.dataLayer = window.dataLayer || [];</script>

  <!-- V.I.A Motriz: guarda a origem da visita (Google, Meta, direto) e
       manda cópia de todo formulário enviado pro CRM da VIA Growth. -->
  <script is:inline src="https://app.viamotriz.com.br/rastreio.js" async></script>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  {jsonld && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonld)} />}
</head>
<body>
  <header class="site-header">
    <div class="header-inner">
      <a class="brand" href="/" aria-label="VIA Growth, página inicial"><img src="/logo-via.png" alt="VIA Growth" width="123" height="30" /></a>
      <nav class="menu" id="menu" aria-label="Menu principal">
        <a href={`${h}#como-trabalhamos`}>Como trabalhamos</a>
        <a href={`${h}#quem-somos`}>Quem somos</a>
        <a href="/blog/" aria-current={ativo === 'blog' ? 'page' : undefined}>Blog</a>
        <a href={`${h}#perguntas`}>Perguntas</a>
      </nav>
      <a class="btn btn-sm header-cta" href={`${h}#form`} data-cta="menu">Pedir diagnóstico</a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="menu"><span aria-hidden="true"></span>Menu</button>
    </div>
  </header>

  <main><slot /></main>

  <footer class="site-footer">
    <div class="wrap">
      <div class="footer-grid">
        <div>
          <img src="/logo-via.png" alt="VIA Growth" width="115" height="28" loading="lazy" />
          <p>Marketing e vendas pra quem vende com atendimento: do anúncio até o contrato assinado.</p>
        </div>
        <div>
          <h2>Site</h2>
          <ul>
            <li><a href={`${h}#como-trabalhamos`}>Como trabalhamos</a></li>
            <li><a href={`${h}#quem-somos`}>Quem somos</a></li>
            <li><a href="/blog/">Blog</a></li>
            <li><a href={`${h}#perguntas`}>Perguntas frequentes</a></li>
            <li><a href="/embaixadores/">Programa de Embaixadores</a></li>
          </ul>
        </div>
        <div>
          <h2>Contato</h2>
          <ul>
            <li><a href={`${h}#form`} data-cta="rodape">Pedir diagnóstico gratuito</a></li>
            <li><a href="mailto:contato@viagrowth.com.br">contato@viagrowth.com.br</a></li>
            <li><a href="https://www.instagram.com/orobsonads/" rel="noopener" target="_blank">Instagram</a></li>
            <li>Barueri, SP. Atendemos o Brasil inteiro.</li>
          </ul>
        </div>
      </div>
      <div class="footer-base">
        <span>© {ano} VIA Growth. CNPJ 54.450.045/0001-97.</span>
        <span><a href="/politica-de-privacidade/">Política de Privacidade</a> · <a href="/rss.xml">RSS do blog</a></span>
      </div>
    </div>
  </footer>

  <script is:inline>
    // menu do celular
    (function () {
      var bt = document.querySelector('.menu-toggle'), menu = document.getElementById('menu');
      if (!bt || !menu) return;
      function fechar() { menu.classList.remove('aberto'); bt.setAttribute('aria-expanded', 'false'); }
      bt.addEventListener('click', function () {
        var abrir = !menu.classList.contains('aberto');
        menu.classList.toggle('aberto', abrir);
        bt.setAttribute('aria-expanded', String(abrir));
      });
      menu.addEventListener('click', function (e) { if (e.target.closest('a')) fechar(); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') fechar(); });
    })();

    // cta_click: todo botão que leva ao formulário, com o texto e o lugar de onde saiu
    document.addEventListener('click', function (e) {
      var a = e.target.closest && e.target.closest('[data-cta]');
      if (!a) return;
      window.dataLayer.push({
        event: 'cta_click',
        cta_texto: (a.textContent || '').trim().replace(/\s+/g, ' '),
        cta_local: a.getAttribute('data-cta'),
        pagina: location.pathname
      });
    });
  </script>
</body>
</html>
