---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import fs from 'node:fs';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { type Post, getPosts, dataBR, leitura, nomeCategoria } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: {
      post,
      // relacionados: mesma categoria primeiro, depois os mais novos
      relacionados: [
        ...posts.filter((p) => p.id !== post.id && p.data.categoria === post.data.categoria),
        ...posts.filter((p) => p.id !== post.id && p.data.categoria !== post.data.categoria),
      ].slice(0, 3),
    },
  }));
}

const { post, relacionados } = Astro.props as { post: Post; relacionados: Post[] };
const { Content } = await render(post);
const d = post.data;
const url = new URL(Astro.url.pathname, Astro.site).href;
// imagem de compartilhamento do post (gerada por scripts/gerar_og.py); sem ela, usa a padrão
const ogPost = fs.existsSync(`public/og/${post.id}.png`) ? `/og/${post.id}.png` : '/og-padrao.png';

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.titulo,
  description: d.resumo,
  datePublished: d.data.toISOString(),
  dateModified: (d.atualizado ?? d.data).toISOString(),
  inLanguage: 'pt-BR',
  mainEntityOfPage: url,
  image: new URL(ogPost, Astro.site).href,
  articleSection: nomeCategoria(d.categoria),
  keywords: d.tags.join(', '),
  author: { '@type': 'Person', name: 'Robson Silva', jobTitle: 'Fundador da VIA Growth', url: 'https://viagrowth.com.br/' },
  publisher: { '@type': 'Organization', name: 'VIA Growth', url: 'https://viagrowth.com.br/', logo: { '@type': 'ImageObject', url: new URL('/logo-via.png', Astro.site).href } },
};
---
<Base titulo={`${d.titulo} | VIA Growth`} descricao={d.resumo} tipo="article" jsonld={jsonld} ativo="blog" og={ogPost}>
  <article>
    <header class="post-head narrow">
      <a class="post-cat" href={`/blog/categoria/${d.categoria}/`}>{nomeCategoria(d.categoria)}</a>
      <h1>{d.titulo}</h1>
      <p class="lede">{d.resumo}</p>
      <p class="post-meta">Por Robson Silva, em <time datetime={d.data.toISOString()}>{dataBR(d.data)}</time>. Leitura de {leitura(post.body)} min.</p>
    </header>

    <figure class="post-capa">
      <Image src={d.capa} alt={d.capaAlt} widths={[640, 1000, 1400]} sizes="(max-width: 1000px) 100vw, 1000px" loading="eager" fetchpriority="high" />
      {d.capaCredito && <figcaption>Foto: <a href={d.capaCredito.url} rel="nofollow noopener" target="_blank">{d.capaCredito.autor} / Pexels</a></figcaption>}
    </figure>

    <div class="prose narrow"><Content /></div>

    <div class="narrow">
      <div class="autor">
        <img src="/robson.webp" alt="" width="56" height="56" loading="lazy" />
        <div><strong>Robson Silva</strong><span>Fundador da VIA Growth. Opera tráfego e processo comercial de negócios de venda consultiva todo dia.</span></div>
      </div>
      <aside class="cta-box">
        <h2>Quer ver isso aplicado no seu negócio?</h2>
        <p>Diagnóstico gratuito da sua captação. A gente olha anúncio, atendimento e funil e te mostra onde está o vazamento.</p>
        <a href="/#form" class="btn" data-cta={`post:${post.id}`}>Pedir diagnóstico gratuito</a>
      </aside>
    </div>
  </article>

  {relacionados.length > 0 && (
    <section class="relacionados">
      <div class="wrap">
        <h2>Leia também</h2>
        <div class="posts">{relacionados.map((p) => <PostCard post={p} nivel="h3" />)}</div>
      </div>
    </section>
  )}
</Base>
