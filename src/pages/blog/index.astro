---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../lib/posts';
import { CATEGORIAS } from '../../content.config';

const posts = await getPosts();
const [primeiro, ...resto] = posts;
const usadas = new Set(posts.map((p) => p.data.categoria));
---
<Base
  titulo="Blog da VIA Growth: marketing e vendas sem complicação"
  descricao="Dicas práticas de marketing e vendas pra loja de móveis planejados e negócio de venda consultiva: atendimento, time comercial, CRM e anúncios, em linguagem simples."
  ativo="blog"
>
  <header class="blog-head wrap">
    <h1>Marketing e vendas, sem complicação.</h1>
    <p class="lede">Dicas práticas pra quem toca loja de móveis planejados e negócio de venda consultiva: atendimento, time comercial, CRM e anúncios. Em português de dono de negócio.</p>
    <nav class="cats" aria-label="Categorias do blog">
      <a class="cat" href="/blog/" aria-current="page">Tudo</a>
      {Object.entries(CATEGORIAS).filter(([slug]) => usadas.has(slug as keyof typeof CATEGORIAS)).map(([slug, c]) => <a class="cat" href={`/blog/categoria/${slug}/`}>{c.nome}</a>)}
    </nav>
  </header>

  <section class="wrap">
    {posts.length === 0 ? (
      <p class="vazio">Os primeiros posts saem em breve.</p>
    ) : (
      <div class="posts">
        <PostCard post={primeiro} destaque />
        {resto.map((p) => <PostCard post={p} />)}
      </div>
    )}
  </section>
</Base>
