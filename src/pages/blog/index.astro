---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../lib/posts';
import { CATEGORIAS } from '../../content.config';

const posts = await getPosts();
const [primeiro, ...resto] = posts;
const usadas = new Set(posts.map((p) => p.data.categoria));
---
<Base
  titulo="Blog da VIA Growth: dicas de tráfego, vendas e mercado"
  descricao="Uma dica prática por dia útil sobre anúncios, atendimento e vendas, mais o que mudou no mercado de Meta, Google e IA. Escrito por quem opera conta todo dia."
  ativo="blog"
>
  <header class="page-head container">
    <div class="eyebrow">Blog da VIA Growth</div>
    <h1>O que está funcionando <span class="accent">agora</span> em anúncio e venda.</h1>
    <p>Uma dica prática por dia útil, o que mudou no mercado e cases com número. Escrito por quem opera conta todo dia, não por quem só lê sobre.</p>
    <nav class="cats" aria-label="Categorias">
      <a class="cat" href="/blog/" aria-current="page">Tudo</a>
      {Object.entries(CATEGORIAS).filter(([slug]) => usadas.has(slug as keyof typeof CATEGORIAS)).map(([slug, c]) => <a class="cat" href={`/blog/categoria/${slug}/`}>{c.nome}</a>)}
    </nav>
  </header>

  <section class="container">
    {posts.length === 0 ? (
      <p class="vazio">Os primeiros posts saem em breve.</p>
    ) : (
      <div class="posts">
        <PostCard post={primeiro} destaque />
        {resto.map((p) => <PostCard post={p} />)}
      </div>
    )}
  </section>
</Base>
